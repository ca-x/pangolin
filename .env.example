PANGOLIN_BIND=0.0.0.0:8080
PANGOLIN_DATA_DIR=./data
# PANGOLIN_DATABASE_URL=sqlite://./data/pangolin.db?mode=rwc
# PANGOLIN_OBSERVATION_PATH=./data/observability.duckdb
# PANGOLIN_OBSERVATION_RETENTION_DAYS=30
# PANGOLIN_PUBLIC_URL=https://gateway.example.com
# PANGOLIN_SESSION_SECURE=true
# PANGOLIN_CAPTURE_PAYLOADS=false
# PANGOLIN_UPSTREAM_TIMEOUT_SECS=600

# Non-interactive first-run initialization. Set both or neither.
# PANGOLIN_ADMIN_EMAIL=admin@example.com
# PANGOLIN_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Optional: unpadded base64 encoding of exactly 32 random bytes.
# If omitted, Pangolin creates data/master.key with mode 0600.
# PANGOLIN_MASTER_KEY=

RUST_LOG=pangolin=info,tower_http=info
